.screen-root {
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;
}

.debug-panel {
    width: 460px;
    padding: 18px;
    background: #14161A;
    border-radius: 14px;
    border: 1px #2C313A;
    gap: 12px;
}

/* header */
.header-row {
    width: 100%;
    gap: 8px;
    align-items: center;
}

.header-icon {
    color: #E8B84A;
    font-size: 16px;
}

.header-title {
    color: #E8B84A;
    font-size: 18px;
}

.header-line {
    flex-grow: 1;
    height: 1px;
    background: #3A3F4B;
}

.header-diamond {
    color: #6A7380;
    font-size: 10px;
}

/* tabs */
.tabs-row {
    width: 100%;
    gap: 8px;
}

.tab {
    padding: 8px 12px;
    background: #1C2026;
    border-radius: 10px;
    border: 1px #2C313A;
    gap: 6px;
    cursor: pointer;
}

.tab:hover {
    background: #242A32;
}

.tab-active {
    background: #1A1E24;
    border: 1px #E8B84A;
}

.tab-icon {
    color: #9AA3B0;
    font-size: 12px;
}

.tab-active .tab-icon {
    color: #E8B84A;
}

.tab-label {
    color: #C5CCD6;
    font-size: 12px;
}

.tab-active .tab-label {
    color: #E8B84A;
}

.tabs-underline {
    width: 100%;
    height: 1px;
    background: #2C313A;
}

/* content */
.content {
    width: 100%;
    gap: 10px;
}

.section-header {
    width: 100%;
    gap: 8px;
    align-items: center;
}

.section-icon {
    color: #E8B84A;
    font-size: 14px;
}

.section-title {
    color: #E8B84A;
    font-size: 14px;
}

.section-line {
    flex-grow: 1;
    height: 1px;
    background: #3A3F4B;
}

/* status */
.status-card {
    width: 100%;
    padding: 10px 12px;
    background: #1A1E24;
    border-radius: 10px;
    border: 1px #2C313A;
    align-items: center;
    justify-content: space-between;
}

.status-label {
    color: #A0A8B8;
    font-size: 13px;
}

.toggle-box {
    padding: 4px 10px;
    background: #12151A;
    border-radius: 8px;
    border: 1px #2C313A;
    gap: 8px;
    align-items: center;
    cursor: pointer;
}

.toggle-arrow {
    color: #6A7380;
    font-size: 11px;
}

.toggle-on {
    color: #55FF55;
    font-size: 13px;
}

.toggle-off {
    color: #FF5555;
    font-size: 13px;
}

/* buttons */
.action-primary {
    width: 100%;
    padding: 12px 14px;
    background: #1A1E24;
    border-radius: 10px;
    border: 1px #E8B84A;
    cursor: pointer;
}

.action-primary:hover {
    background: #22282F;
}

.action-primary-text {
    color: #E8B84A;
    font-size: 13px;
}

.action-secondary {
    width: 100%;
    padding: 12px 14px;
    background: #1A1E24;
    border-radius: 10px;
    border: 1px #2C313A;
    cursor: pointer;
}

.action-secondary:hover {
    background: #22282F;
}

.action-secondary-text {
    color: #B0B8C4;
    font-size: 13px;
}

/* hint */
.hint-card {
    width: 100%;
    padding: 10px 12px;
    background: #161A20;
    border-radius: 10px;
    border: 1px #2C313A;
    gap: 8px;
    align-items: center;
}

.hint-icon {
    color: #6A7380;
    font-size: 12px;
}

.hint-text {
    color: #7E8796;
    font-size: 12px;
}

/* close */
.close-btn {
    align-self: center;
    padding: 8px 18px;
    background: #1A1E24;
    border-radius: 10px;
    border: 1px #2C313A;
    cursor: pointer;
}

.close-btn:hover {
    background: #242A32;
}

.close-text {
    color: #9AA3B0;
    font-size: 13px;
}