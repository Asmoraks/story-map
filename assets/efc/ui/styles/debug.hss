.screen-root {
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;
}

.debug-panel {
    width: 380px;
    padding: 12px;
    background: #14161A;
    border-radius: 12px;
    border: 1px #2C313A;
    gap: 8px;
}

/* HEADER */
.header-row {
    width: 100%;
    gap: 6px;
    align-items: center;
}

.header-icon {
    color: #E8B84A;
    font-size: 14px;
}

.header-title {
    color: #E8B84A;
    font-size: 15px;
}

.header-line {
    flex-grow: 1;
    height: 1px;
    background: #3A3F4B;
}

.header-diamond {
    color: #6A7380;
    font-size: 9px;
}

/* TABS */
.tabs-row {
    width: 100%;
    gap: 5px;
}

.tab {
    padding: 5px 8px;
    background: #1C2026;
    border-radius: 8px;
    border: 1px #2C313A;
    gap: 4px;
    cursor: pointer;
}

.tab:hover {
    background: #242A32;
}

.tab-active {
    background: #1A1E24;
    border: 1px #E8B84A;
}

.tab-icon {
    color: #9AA3B0;
    font-size: 11px;
}

.tab-active .tab-icon {
    color: #E8B84A;
}

.tab-label {
    color: #C5CCD6;
    font-size: 11px;
}

.tab-active .tab-label {
    color: #E8B84A;
}

.tabs-underline {
    width: 100%;
    height: 1px;
    background: #2C313A;
}

/* CONTENT */
.content {
    width: 100%;
    gap: 6px;
}

.section-header {
    width: 100%;
    gap: 6px;
    align-items: center;
}

.section-icon {
    color: #E8B84A;
    font-size: 12px;
}

.section-title {
    color: #E8B84A;
    font-size: 12px;
}

.section-line {
    flex-grow: 1;
    height: 1px;
    background: #3A3F4B;
}

.section-frame {
    width: 100%;
    padding: 8px;
    background: #161A20;
    border-radius: 10px;
    border: 1px #2C313A;
    gap: 6px;
}

/* STATUS */
.status-card {
    width: 100%;
    padding: 6px 8px;
    background: #1A1E24;
    border-radius: 8px;
    border: 1px #2C313A;
    align-items: center;
    justify-content: space-between;
}

.status-label {
    color: #A0A8B8;
    font-size: 11px;
}

.toggle-box {
    padding: 3px 8px;
    background: #12151A;
    border-radius: 6px;
    border: 1px #2C313A;
    gap: 6px;
    align-items: center;
    cursor: pointer;
}

.toggle-arrow {
    color: #6A7380;
    font-size: 10px;
}

.toggle-on {
    color: #55FF55;
    font-size: 11px;
}

.toggle-off {
    color: #FF5555;
    font-size: 11px;
}

/* BUTTONS */
.action-primary {
    width: 100%;
    padding: 8px 10px;
    background: #1A1E24;
    border-radius: 8px;
    border: 1px #E8B84A;
    cursor: pointer;
}

.action-primary:hover {
    background: #22282F;
}

.action-primary-text {
    color: #E8B84A;
    font-size: 11px;
}

.action-secondary {
    width: 100%;
    padding: 8px 10px;
    background: #1A1E24;
    border-radius: 8px;
    border: 1px #2C313A;
    cursor: pointer;
}

.action-secondary:hover {
    background: #22282F;
}

.action-secondary-text {
    color: #B0B8C4;
    font-size: 11px;
}

/* LIST — ограничение высоты */
.list-card {
    width: 100%;
    max-height: 90px;
    padding: 6px;
    background: #12151A;
    border-radius: 8px;
    border: 1px #2C313A;
    gap: 4px;
}

.list-header {
    width: 100%;
    justify-content: space-between;
    align-items: center;
}

.list-title {
    color: #C5CCD6;
    font-size: 11px;
}

.list-count {
    color: #E8B84A;
    font-size: 11px;
}

.list-empty {
    width: 100%;
    padding: 4px;
}

.list-empty-text {
    color: #6A7380;
    font-size: 10px;
}

.list-body {
    width: 100%;
    gap: 2px;
}

.list-item {
    width: 100%;
    padding: 3px 6px;
    background: #1A1E24;
    border-radius: 6px;
    gap: 6px;
    align-items: center;
}

.list-item-icon {
    color: #E8B84A;
    font-size: 10px;
}

.list-item-text {
    color: #B0B8C4;
    font-size: 10px;
}

.list-item-remove {
    color: #E06C75;
    font-size: 10px;
}

/* HINT */
.hint-card {
    width: 100%;
    padding: 6px 8px;
    background: #12151A;
    border-radius: 8px;
    border: 1px #2C313A;
    gap: 6px;
    align-items: center;
}

.hint-icon {
    color: #6A7380;
    font-size: 10px;
}

.hint-text {
    color: #7E8796;
    font-size: 10px;
}
/* FOOTER */
.footer {
    width: 100%;
    justify-content: center;
    align-items: center;
    padding-top: 2px;
}

.close-btn {
    padding: 6px 14px;
    background: #1A1E24;
    border-radius: 8px;
    border: 1px #2C313A;
    cursor: pointer;
}

.close-btn:hover {
    background: #242A32;
}

.close-text {
    color: #9AA3B0;
    font-size: 11px;
}